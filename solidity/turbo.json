{
  "extends": ["//"],
  "tasks": {
    "deps:soldeer": {
      "inputs": ["foundry.toml", "soldeer.lock"],
      "outputs": ["dependencies/**"]
    },
    "build": {
      "dependsOn": ["deps:soldeer", "version:update"],
      "outputs": [
        "artifacts/**",
        "cache/**",
        "core-utils/**",
        "dist/**",
        "!dist/tron/**",
        "types/**"
      ]
    },
    "build:tron": {
      "dependsOn": ["deps:soldeer", "version:update"]
    }
  }
}
