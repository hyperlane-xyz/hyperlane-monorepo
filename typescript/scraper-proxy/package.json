{
  "name": "@hyperlane-xyz/scraper-proxy",
  "version": "0.0.0",
  "private": true,
  "description": "GraphQL proxy for the scraper database",
  "homepage": "https://www.hyperlane.xyz",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/hyperlane-xyz/hyperlane-monorepo"
  },
  "files": [
    "src",
    "dist"
  ],
  "type": "module",
  "main": "dist/main.js",
  "types": "dist/main.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "bundle": "rm -rf ./bundle && ncc build ./dist/main.js -o bundle && mkdir -p bundle/graphql && cp src/graphql/scraperdb-schema.graphql bundle/graphql/ && node ../../scripts/ncc.post-bundle.mjs",
    "clean": "rm -rf ./dist",
    "debug:websocket": "tsx src/scripts/debug-event-websocket.ts",
    "dev": "NODE_ENV=development LOG_FORMAT=pretty tsx watch src/main.ts",
    "format": "oxfmt --write ./src",
    "lint": "oxlint -c ../../oxlint.json",
    "start": "node dist/main.js",
    "start:dev": "NODE_ENV=development LOG_FORMAT=pretty node dist/main.js",
    "test": "tsx --test src/*.test.ts src/**/*.test.ts",
    "test:ci": "pnpm test"
  },
  "dependencies": {
    "@apollo/server": "catalog:",
    "@as-integrations/express5": "catalog:",
    "@nestjs/apollo": "catalog:",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/graphql": "catalog:",
    "@nestjs/platform-express": "catalog:",
    "dotenv-flow": "^4.1.0",
    "graphql": "catalog:",
    "pg": "^8.17.2",
    "prom-client": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "ws": "^8.21.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@hyperlane-xyz/tsconfig": "workspace:^",
    "@types/node": "catalog:",
    "@types/pg": "^8.16.0",
    "@types/ws": "catalog:",
    "@vercel/ncc": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=20"
  },
  "typedocMain": "src/main.ts"
}
