PORT=8383
DATABASE_URL="postgresql://..."
# Configure TLS explicitly in the URL when required, e.g. sslmode=verify-full.
EVENT_STREAM_BATCH_SIZE=500
EVENT_STREAM_MAX_BUFFERED_BYTES=1048576
EVENT_STREAM_MAX_TOTAL_BUFFERED_BYTES=33554432
GRAPHQL_MAX_ACTIVE_REQUESTS=25
# Bounds aggregate request-body buffering independently of GraphQL execution.
GRAPHQL_MAX_ACTIVE_UPLOADS=50
# Optional, same diagnostics Postgres written by relayers (NOT the scraper DB).
# TODO: provision its read-only user and wire the production secret once online.
# DIAGNOSTICS_DATABASE_URL="postgresql://diagnostics_reader:...@.../diagnostics"
