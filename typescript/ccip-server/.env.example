DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ccip_server"
ENABLED_MODULES=cctp,callCommitments
# LayerZero pull-mode example:
# ENABLED_MODULES=cctp,callCommitments,layerzero
# HYPERLANE_EXPLORER_URL=https://explorer.hyperlane.xyz/graphql
SERVER_PORT=3000
SERVER_BASE_URL=http://localhost:3000
# If you want to use a different registry
# REGISTRY_URI=/Users/nambrot/devstuff/hyperlane-registry
# Public Ethereum addresses allowed to read commitment calldata.
CCS_AUTHORIZED_SIGNERS='["0x74cae0ecc47b02ed9b9d32e000fd70b9417970c5"]'
# Registers GET /callCommitments/calldata/:commitment ('true' or 'false').
# Keep unset (disabled) in production until the Sealevel reveal flow is
# redesigned; enable only for local testing.
# CCS_CALLDATA_LOOKUP_ENABLED=false

# Wormhole CCIP-read module (ENABLED_MODULES=wormhole)
# Routes are discovered on chain from the requesting hook/ISM; RPCs come from
# the registry selected by REGISTRY_URI.
HYPERLANE_EXPLORER_URL=https://explorer.hyperlane.xyz/graphql
# Redundant Wormholescan-compatible endpoints, queried in parallel.
WORMHOLE_VAA_URLS=https://api.wormholescan.io
# WORMHOLE_VAA_TIMEOUT_MS=10000
# WORMHOLE_VAA_MAX_BYTES=65536
# WORMHOLE_VAA_MAX_ATTEMPTS=4
# WORMHOLE_VAA_RETRY_DELAY_MS=1000
